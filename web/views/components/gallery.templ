package components

import "workshop/internal/domain/sighting"

templ Gallery(items []sighting.Media) {
	if len(items) == 0 {
		<p class="gallery__empty">No media recorded.</p>
	} else {
		<ul class="gallery">
			for _, m := range items {
				<li class="gallery__item">
					<figure class="gallery__item">
						if m.Type == "StillImage" {
							<a href={ templ.URL(m.URL) } rel="noopener" target="_blank">
								<img src={ m.URL } alt={ altText(m) } loading="lazy"/>
							</a>
						} else {
							<a class="gallery__file" href={ templ.URL(m.URL) } rel="noopener">{ altText(m) }</a>
						}
						if m.Creator != "" {
							<figcaption class="gallery__credit">© { m.Creator }</figcaption>
						}
					</figure>
				</li>
			}
		</ul>
	}
}
