package components

import "workshop/web/views/vm"

type PhotoProps struct {
	Photo vm.Photo
	// Name is the species shown, for the placeholder when there's no photo.
	Name  string
	Size  string
	Eager bool
	Class string
}

// Photo is an image over a shimmering placeholder, or, when there is
// none, a drawn placeholder lettered with the species' initial.
templ Photo(p PhotoProps) {
	if p.Photo.URL == "" {
		<div class={ "photo", "photo--empty", p.Class } role="img" aria-label={ "No photograph of " + p.Name + " yet" }>
			<span class="photo__initial" aria-hidden="true">{ initial(p.Name) }</span>
		</div>
	} else {
		<div class={ "photo", p.Class }>
			<img
				src={ photoSrc(p) }
				alt={ p.Photo.Alt }
				if p.Eager {
					fetchpriority="high"
				} else {
					loading="lazy"
				}
				decoding="async"
				referrerpolicy="no-referrer"
			/>
		</div>
	}
}

func photoSrc(p PhotoProps) string {
	switch p.Size {
	case "large":
		return p.Photo.Large
	case "small":
		return p.Photo.Small
	}
	return p.Photo.URL
}

func initial(name string) string {
	for _, r := range name {
		return string(r)
	}
	return "?"
}

// Credit names who took a photo and its licence.
templ Credit(p vm.Photo) {
	if p.Credit != "" || p.License != "" {
		<span class="credit">
			if p.Credit != "" {
				<span>© { p.Credit }</span>
			}
			if p.License != "" {
				<span class="credit__license">{ p.License }</span>
			}
		</span>
	}
}

// IUCNBadge shows a Red List category, marking threatened ones.
templ IUCNBadge(c vm.IUCN) {
	if c.Code != "" {
		<span
			class={ "iucn", templ.KV("iucn--threatened", c.Threatened) }
			title={ "IUCN Red List: " + c.Label }
		>
			<abbr class="iucn__code" title="IUCN Red List category">{ c.Code }</abbr>
			<span class="iucn__label">{ c.Label }</span>
		</span>
	}
}
