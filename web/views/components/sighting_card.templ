package components

import "workshop/internal/domain/sighting"

templ SightingCard(s sighting.Sighting) {
	<article class="card">
		<div class="card__photo">
			if photo, ok := CoverPhoto(s); ok {
				<img src={ photo.URL } alt={ DisplayName(s.Species) } loading="lazy" decoding="async"/>
			} else {
				<div class="photo-empty">
					@IconImage()
					<span>No photo</span>
				</div>
			}
			<span class="card__glare" aria-hidden="true"></span>
			<div class="card__overlay">
				if s.IndividualCount != nil {
					<span class="card__badge">{ Individuals(*s.IndividualCount) }</span>
				}
				<h3 class="card__title">
					<a class="card__link" href={ SightingURL(s) }>{ DisplayName(s.Species) }</a>
				</h3>
				if s.Species.ScientificName != "" {
					<p class="card__scientific">{ s.Species.ScientificName }</p>
				}
			</div>
		</div>
		<ul class="facts card__facts">
			<li>
				@IconPin()
				<span>{ Place(s.Location) }</span>
			</li>
			<li>
				@IconCalendar()
				<time datetime={ s.HappenedAt.Format("2006-01-02") }>{ s.HappenedAt.Format("2 Jan 2006") }</time>
			</li>
			if s.RecordedBy != "" {
				<li class="card__observer">
					@IconUser()
					<span>{ s.RecordedBy }</span>
				</li>
			}
		</ul>
	</article>
}
