package layout

type BaseProps struct {
	Title string
}

templ Base(props BaseProps) {
	<!DOCTYPE html>
	<html lang="en-GB">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ props.Title }</title>
			<link rel="stylesheet" href="/assets/showcase/index.css"/>
		</head>
		<body>
			{ children... }
			<script type="module" src="/assets/showcase/index.js"></script>
		</body>
	</html>
}
