package pages

import (
	"strconv"
	"workshop/web/views/components"
	"workshop/web/views/layout"
	"workshop/web/views/vm"
)

templ Error(site vm.Site, message string, code int) {
	@layout.Base(layout.BaseProps{
		Title: "Error " + strconv.Itoa(code),
		Site:  site,
	}) {
		<section class="error-page">
			<p class="error-page__code display" aria-hidden="true">{ strconv.Itoa(code) }</p>
			<div>
				@components.Eyebrow("Error " + strconv.Itoa(code))
				<h1 class="display error-page__title">
					if code == 404 {
						Lost the trail
					} else {
						Something spooked the herd
					}
				</h1>
				<p class="error-page__text">{ message }</p>
				<div class="hero__actions">
					@components.PillButton(components.ButtonProps{Href: "/", Label: "Back to the atlas", Variant: "amber"})
					@components.PillButton(components.ButtonProps{Href: "/species", Label: "All species", Variant: "dark"})
				</div>
			</div>
		</section>
	}
}
